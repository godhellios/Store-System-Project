generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum OrderType {
  GRN
  GOODS_OUT
  TRANSFER
  ADJUSTMENT
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum OpnameStatus {
  IN_PROGRESS
  REVIEWING
  APPROVED
  CANCELLED
}

enum UserRole {
  ADMIN
  STAFF
  VIEWER
  OPERATOR
}

enum ProductApprovalStatus {
  DRAFT
  ACTIVE
  REJECTED
}

// ─── Models ──────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  password             String
  role                 UserRole  @default(STAFF)
  isActive             Boolean   @default(true)
  activeSessionId      String?
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  email     String
  ip        String?
  userAgent String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// User-managed units of measure (editable from Settings)
model Unit {
  id               String   @id @default(cuid())
  name             String   @unique
  suffix           String?  // barcode suffix e.g. "BOX", "CRT" — max 5 chars
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  parentUnitId     String?
  conversionFactor Float?   // 1 of this unit = conversionFactor of parentUnit

  parent   Unit?  @relation("UnitHierarchy", fields: [parentUnitId], references: [id])
  children Unit[] @relation("UnitHierarchy")

  products Product[]
}

// User-managed product categories (editable from Settings)
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique   // 3-4 letter SKU prefix e.g. "BTN", "ZIP"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products Product[]
  opnameSessions OpnameSession[]
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stock          Stock[]
  ordersFrom     Order[]         @relation("OrderFromLocation")
  ordersTo       Order[]         @relation("OrderToLocation")
  movementsFrom  Movement[]      @relation("MovementFrom")
  movementsTo    Movement[]      @relation("MovementTo")
  opnameSessions OpnameSession[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  orders Order[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  sku          String   @unique
  barcode      String   @unique
  category     Category @relation(fields: [categoryId], references: [id])
  categoryId   String
  unit         Unit     @relation(fields: [unitId], references: [id])
  unitId       String
  reorderPoint Int      @default(0)
  imageUrl     String?
  colorVariant String?
  description  String?
  isActive          Boolean   @default(true)
  approvalStatus    ProductApprovalStatus?  // null = legacy active (pre-approval-workflow products)
  pendingChanges    Json?     // proposed edit fields as JSON object
  pendingChangedBy  String?   // name of staff who submitted edit
  pendingChangedAt  DateTime? // when edit was submitted
  reviewedByName    String?   // admin who reviewed
  reviewedAt        DateTime? // when reviewed
  reviewNote        String?   // rejection reason shown to staff
  lastCost          Decimal?  // last purchase price from any approved GRN
  avgCost           Decimal?  // weighted average cost across all approved GRN receipts
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  stock           Stock[]
  orderLines      OrderLine[]
  movements       Movement[]
  opnameLines     OpnameLine[]
  unitConversions ProductUnitConversion[]

  @@index([categoryId])
  @@index([isActive, approvalStatus])
}

// Per-product packaging / larger-unit definitions
// Example: Product "Thread Roll" can have 1 Box = 12 rolls, 1 Carton = 144 rolls
model ProductUnitConversion {
  id               String  @id @default(cuid())
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  name             String  // e.g., "Box", "Carton", "Lusin"
  conversionFactor Float   // 1 of this unit = conversionFactor base units
  barcode          String? @unique

  @@unique([productId, name])
}

// Current stock level per product per location
model Stock {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  location   Location @relation(fields: [locationId], references: [id])
  locationId String
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([locationId])
}

// Parent order document (GRN / Goods Out / Transfer / Adjustment)
model Order {
  id             String    @id @default(cuid())
  orderNumber    String    @unique
  type           OrderType
  fromLocation   Location? @relation("OrderFromLocation", fields: [fromLocationId], references: [id])
  fromLocationId String?
  toLocation     Location? @relation("OrderToLocation", fields: [toLocationId], references: [id])
  toLocationId   String?
  customer       String?
  supplier       String?   // legacy free-text (kept for old orders)
  supplierId     String?
  supplierRef    Supplier? @relation(fields: [supplierId], references: [id])
  reference      String?
  notes          String?
  createdByName     String?
  createdAt         DateTime  @default(now())
  effectiveDate     DateTime? // business date (when it really happened); null on legacy rows → treat as createdAt
  whatsappSentAt    DateTime?
  printedAt         DateTime?
  doGeneratedAt     DateTime?
  doSentAt          DateTime?
  adjustmentStatus  String?   // PENDING | APPROVED | REJECTED (null for non-ADJUSTMENT orders)
  adjustmentReason  String?
  grnStatus         String?   // PENDING | APPROVED | REJECTED (null for legacy GRN = approved immediately)
  goodsOutStatus    String?   // PENDING | APPROVED | REJECTED (null = stock applied immediately, no approval)
  transferStatus    String?   // PENDING | APPROVED | REJECTED (null = stock applied immediately, no approval)
  reviewedByName    String?
  reviewedAt        DateTime?
  reviewNote        String?
  cancelledAt       DateTime?
  cancelledByName   String?
  cancelReason      String?
  labelPrinted      Boolean   @default(false)
  labelPrintedAt    DateTime?
  labelPrintedByName String?

  lines     OrderLine[]
  movements Movement[]

  @@index([type, createdAt])
  @@index([grnStatus])
  @@index([goodsOutStatus])
  @@index([transferStatus])
  @@index([adjustmentStatus])
}

// Line items within an order
model OrderLine {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int       // always stored in base units
  inputQty  Float?    // quantity as entered by user (null when base unit was used)
  inputUnit String?   // unit name used for input  (null when base unit was used)
  unitCost  Decimal?  // purchase price per base unit (GRN only, admin-only visibility)
  notes     String?

  movements Movement[]

  @@index([orderId])
}

// Individual stock movements — full audit trail
model Movement {
  id             String       @id @default(cuid())
  order          Order        @relation(fields: [orderId], references: [id])
  orderId        String
  orderLine      OrderLine    @relation(fields: [orderLineId], references: [id])
  orderLineId    String
  product        Product      @relation(fields: [productId], references: [id])
  productId      String
  fromLocation   Location?    @relation("MovementFrom", fields: [fromLocationId], references: [id])
  fromLocationId String?
  toLocation     Location?    @relation("MovementTo", fields: [toLocationId], references: [id])
  toLocationId   String?
  quantity       Int
  type           MovementType
  createdAt      DateTime     @default(now())
  effectiveDate  DateTime?    // business date copied from the parent order; null on legacy rows → treat as createdAt

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([createdAt])
  @@index([productId, effectiveDate])
}

// Stock opname (physical count) session per location
model OpnameSession {
  id            String       @id @default(cuid())
  sessionNumber String       @unique
  location      Location     @relation(fields: [locationId], references: [id])
  locationId    String
  status         OpnameStatus @default(IN_PROGRESS)
  notes          String?
  cancelNote     String?
  createdByName  String?
  approvedByName String?
  createdAt      DateTime     @default(now())
  approvedAt     DateTime?

  lines      OpnameLine[]
  categories Category[]  // scope: empty = whole-warehouse count (all categories)

  @@index([locationId, status])
  @@index([createdAt])
}

// Append-only record of every significant write action in the system
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String
  userRole    String
  action      String
  description String
  entityId    String?
  entityType  String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityId, entityType])
}

// App-wide key-value configuration store
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Individual counted item within an opname session
model OpnameLine {
  id          String        @id @default(cuid())
  session     OpnameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  product     Product       @relation(fields: [productId], references: [id])
  productId   String
  bookQty        Int
  physicalQty    Int?
  difference     Int?
  notes          String?
  staffConfirmed Boolean @default(false)

  @@unique([sessionId, productId])
}
